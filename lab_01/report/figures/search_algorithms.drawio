        <mxCell id="empty" value="size == 0?" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="340.0" y="121.6" width="220" height="100" />
        </mxCell>
        <mxCell id="init" value="begin = 0, end = size&#10;step = bit_floor(size)" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="340.0" y="225.2" width="220" height="56" />
        </mxCell>
        <mxCell id="prepare" value="step != size и&#10;arr[step] &lt; standart?" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="340.0" y="304.0" width="220" height="100" />
        </mxCell>
        <mxCell id="tail" value="end -= step + 1" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90.0" y="412.9" width="220" height="55" />
