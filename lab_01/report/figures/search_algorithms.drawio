          <mxGeometry as="geometry" x="340.0" y="681.6999999999999" width="220" height="55" />
        </mxCell>
        <mxCell id="loop" value="step != 0?" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="340.0" y="740.8" width="220" height="100" />
        </mxCell>
        <mxCell id="compare" value="arr[begin + step]&#10;&lt; standart?" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fontSize=15;" vertex="1" parent="1">
