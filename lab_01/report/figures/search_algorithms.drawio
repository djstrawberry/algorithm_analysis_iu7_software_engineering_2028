        <mxCell id="zero" value="end == 0?" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;shape=rhombus;perimeter=rhombusPerimeter;fontSize=15;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90.0" y="476.79999999999995" width="220" height="100" />
        </mxCell>
        <mxCell id="restart" value="step = bit_ceil(end)&#10;begin = size - step" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="90.0" y="599.6" width="220" height="56" />
        </mxCell>
