        </mxCell>
        <mxCell id="input" value="Вход:&#10;отсортированный массив arr,&#10;размер массива size,&#10;искомый элемент standart" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#000000;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1;align=center;verticalAlign=middle;spacing=4;strokeColor=none;fillColor=none;fontSize=15;" vertex="1" parent="1">
